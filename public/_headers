# NOTE: Cloudflare Pages merges the headers of EVERY matching rule.
# Keep all rules non-overlapping, and add new page paths explicitly.
# Cache Rule "Use cache-control headers when present" then derives the
# edge TTL from s-maxage, while browsers use max-age.

# === Immutable hashed build assets ===
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# === Static theme assets ===
# These filenames have NO content hash (logo.png, dev.svg ...), so `immutable`
# would pin a stale copy in visitor browsers for a year after the file changes.
/assets/*
  Cache-Control: public, max-age=86400

# === Static images ===
/favicon.svg
  Cache-Control: public, max-age=86400

/astropaper-og.jpg
  Cache-Control: public, max-age=86400

/og.png
  Cache-Control: public, max-age=86400

/posts/*.png
  Cache-Control: public, max-age=86400, s-maxage=31536000

# === Home & listing pages: new posts surface within ~10 min ===
# Browser TTL 5 min. Repeat visits inside that window cost zero requests, which
# matters because a fresh connection from China costs ~840 ms (TCP 500 + TLS 340).
/
  Cache-Control: public, max-age=300, s-maxage=600, stale-while-revalidate=86400

/posts/
  Cache-Control: public, max-age=300, s-maxage=600, stale-while-revalidate=86400

/tags/*
  Cache-Control: public, max-age=300, s-maxage=600, stale-while-revalidate=86400

/archives/
  Cache-Control: public, max-age=300, s-maxage=600, stale-while-revalidate=86400

# === Article pages: stable content, kept on the edge for a day ===
# Browser TTL is 1 h. Measured on the live site: every return visit that misses
# the browser cache pays a fresh TLS handshake (~840 ms p75 from China) + a 304.
# Articles rarely change, and the edge copy (s-maxage) stays authoritative.
/posts/:slug/
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800

# === Standalone pages ===
/about/
  Cache-Control: public, max-age=3600, s-maxage=3600, stale-while-revalidate=86400

/search/
  Cache-Control: public, max-age=3600, s-maxage=3600, stale-while-revalidate=86400

# === Feeds & metadata ===
/rss.xml
  Cache-Control: public, max-age=600, s-maxage=3600, stale-while-revalidate=86400

/robots.txt
  Cache-Control: public, max-age=60, s-maxage=3600, stale-while-revalidate=86400

/sitemap*
  Cache-Control: public, max-age=60, s-maxage=3600, stale-while-revalidate=86400

# === Transport security (every path) ===
# This block only sets HSTS - it carries no Cache-Control, so it never
# participates in the edge-TTL merge above. includeSubDomains/preload are
# intentionally omitted: only add them once every subdomain is HTTPS-only.
# Browsers pin this policy for max-age, so it cannot be undone quickly.
/*
  Strict-Transport-Security: max-age=15552000
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
