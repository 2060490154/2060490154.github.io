# Hashed build assets (Astro/Vite output): immutable for one year
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Static theme assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Blog images served from public/posts (unhashed)
/posts/*.png
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

/astropaper-og.jpg
  Cache-Control: public, max-age=604800

# HTML documents & misc files: short browser TTL, background revalidation.
# s-maxage controls the edge cache TTL when the Cache Rule is set to
# "Use cache-control headers when present, otherwise bypass" (5 minutes).
/*
  Cache-Control: public, max-age=60, s-maxage=300, stale-while-revalidate=86400
