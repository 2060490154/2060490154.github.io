---
export interface Props {
  href: string;
  className?: string;
  ariaLabel?: string;
  title?: string;
  disabled?: boolean;
  /** "hover" | "viewport" | false — omit to disable prefetching. */
  prefetch?: "hover" | "viewport" | false;
}

const {
  href,
  className = "",
  ariaLabel,
  title,
  disabled = false,
  prefetch,
} = Astro.props;
---

{
  disabled ? (
    <span
      class:list={["group inline-block", className]}
      title={title}
      aria-disabled={disabled}
    >
      <slot />
    </span>
  ) : (
    <a
      {href}
      data-astro-prefetch={prefetch}
      class:list={["group inline-block hover:text-skin-accent", className]}
      aria-label={ariaLabel}
      title={title}
    >
      <slot />
    </a>
  )
}
